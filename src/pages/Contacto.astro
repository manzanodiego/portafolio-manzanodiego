---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
---

		<div class="flex justify-center pt-30">
			<div class="max-w-2xl w-full">
				<h1 class="text-4xl text-white font-bold mb-8 text-center">Contacto</h1>
				
				<form class="space-y-6" action="#" method="POST">
					<div>
						<label for="nombre" class="block text-white mb-2">Nombre</label>
						<input 
							type="text" 
							id="nombre" 
							name="nombre" 
							required
							class="w-full p-3 rounded-md bg-blue-900/50 text-white border border-blue-700 focus:border-cyan-500 focus:outline-none"
							placeholder="Tu nombre"
						/>
					</div>
					
					<div>
						<label for="email" class="block text-white mb-2">Email</label>
						<input 
							type="email" 
							id="email" 
							name="email" 
							required
							class="w-full p-3 rounded-md bg-blue-900/50 text-white border border-blue-700 focus:border-cyan-500 focus:outline-none"
							placeholder="tu@email.com"
						/>
					</div>
					
					<div>
						<label for="mensaje" class="block text-white mb-2">Mensaje</label>
						<textarea 
							id="mensaje" 
							name="mensaje" 
							rows="5" 
							required
							class="w-full p-3 rounded-md bg-blue-900/50 text-white border border-blue-700 focus:border-cyan-500 focus:outline-none resize-none"
							placeholder="Escribe tu mensaje..."
						></textarea>
					</div>
					
					<button 
						type="submit"
						class="w-full bg-cyan-600 text-white p-3 rounded-md hover:bg-cyan-500 transition-colors font-medium"
					>
						Enviar Mensaje
					</button>
				</form>
				
				<div class="mt-10 text-center text-white">
					<p class="text-lg mb-4">O contáctame directamente:</p>
					<div class="flex justify-center space-x-6">
						<a href="mailto:manzanodie12@gmail.com" class="hover:text-blue-500 transition-colors">
							Email: manzanodie12@gmail.com
						</a>
						
					</div>
				</div>
			</div>
		</div>
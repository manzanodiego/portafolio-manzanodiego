---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import About from "../pages/About.astro"
import Proyectos from "./Proyectos.astro";
import Skills from "./Skills.astro";
import Home from "./Home.astro";
import Contacto from "./Contacto.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		
		<link rel="icon" href="/icon-md.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Diego Manzano - Programador Web</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	</head>
	<body class="flex flex-col px-100 gap-4 font-montserrat relative" id="gradient-bg" >
		<Navbar></Navbar>
		
		<main class="h-screen w-full snap-y snap-mandatory scroll-smooth">
			<section class=" h-screen w-full snap-start ">
				<Home></Home>
			</section>
			<section class=" h-screen w-full snap-start pt-16" id="about">
				<About></About>
			</section>
			<section class="h-screen w-full snap-start pt-16" id="skill">
				<Skills></Skills>
			</section>
			<section class="h-screen w-full snap-start pt-16" id="proyectos">
				<Proyectos></Proyectos>
			</section>
			<section class="h-screen w-full snap-start pt-16" id="contacto">
				<Contacto></Contacto>
			</section>
		</main>



	</body>
</html>

---
import html from '../img/stack/html.png';
import css from '../img/stack/CSS.png';
import bootstrap from '../img/stack/bootstrap.svg';
import tailwindcss from '../img/stack/tailwindcss.svg';
import javascript from '../img/stack/javascript.svg';

const skillsFrontend = [
    { name: 'HTML', img: html },
    { name: 'CSS', img: css },
    { name: 'Bootstrap', img: bootstrap },
    { name: 'Tailwind', img: tailwindcss },
    { name: 'JavaScript', img: javascript },
];

import flask from '../img/stack/flask.svg';
import java from '../img/stack/java.svg';
import python from '../img/stack/python.svg';
import php from '../img/stack/WhhPhp.svg';
import laravel from '../img/stack/laravel.svg';
import mysql from '../img/stack/mysql.svg';

const skillsBackend = [
    { name: 'Flask', img: flask },
    { name: 'Java', img: java },
    { name: 'Python', img: python },
    { name: 'PHP', img: php },
    { name: 'Laravel', img: laravel },
    { name: 'MySQL', img: mysql },
];

import linux from '../img/stack/linux.svg';
import git from '../img/stack/git.png';
import fedora from '../img/stack/fedora.png';
import vscode from '../img/stack/vscode.png';

const herramientas = [
    { name: 'Linux', img: linux },
    { name: 'Git', img: git },
    { name: 'Fedora', img: fedora },
    { name: 'VS Code', img: vscode },
];
---

<div class="mt-10 text-white">
    <h2 class="font-bold text-xl pb-1.5">Tecnologias Frontend</h2>
    <div class="flex flex-wrap gap-4">
        {skillsFrontend.map((skill) => 
            <div class="bg-blue-900/50 p-4 rounded-md flex flex-col items-center">
                <img class="iconos" src={skill.img.src} alt={skill.name} />
                <span class="mt-2 text-sm">{skill.name}</span>
            </div>
        )}
    </div>
</div>

<div class="mt-10 text-white">
    <h2 class="font-bold text-xl pb-1.5">Tecnologias Backend</h2>
    <div class="flex flex-wrap gap-4">
        {skillsBackend.map((skill) => 
            <div class="bg-blue-900/50 p-4 rounded-md flex flex-col items-center">
                <img class="iconos" src={skill.img.src} alt={skill.name} />
                <span class="mt-2 text-sm">{skill.name}</span>
            </div>
        )}
    </div>
</div>

<div class="mt-10 text-white">
    <h2 class="font-bold text-xl pb-1.5">Herramientas</h2>
    <div class="flex flex-wrap gap-4">
        {herramientas.map((skill) => 
            <div class="bg-blue-900/50 p-4 rounded-md flex flex-col items-center">
                <img class="iconos" src={skill.img.src} alt={skill.name} />
                <span class="mt-2 text-sm">{skill.name}</span>
            </div>
        )}
    </div>
</div>